<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit scenario names use underscores to keep behavior readable in test output. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StaticArtifactLab.Cli\StaticArtifactLab.Cli.csproj" />
    <ProjectReference Include="..\StaticArtifactLab.Core\StaticArtifactLab.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\StaticArtifactLab.Gui\MainWindow.xaml" Link="Gui\MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
